@@ -112,9 +112,17 @@ static int aicwf_vendor_start_mkeep_alive(struct wiphy *wiphy,
 		type = nla_type(iter);
 		switch (type) {
 		case MKEEP_ALIVE_ATTRIBUTE_ID:
+			if (nla_len(iter) < sizeof(u8)) {
+				ret = -EINVAL;
+				goto exit;
+			}
 			mkeep_alive_id = nla_get_u8(iter);
 			break;
 		case MKEEP_ALIVE_ATTRIBUTE_IP_PKT_LEN:
+			if (nla_len(iter) < sizeof(u16)) {
+				ret = -EINVAL;
+				goto exit;
+			}
 			ip_pkt_len = nla_get_u16(iter);
 			if (ip_pkt_len > MKEEP_ALIVE_IP_PKT_MAX) {
 				ret = -EINVAL;
@@ -122,11 +130,12 @@ static int aicwf_vendor_start_mkeep_alive(struct wiphy *wiphy,
 			}
 			break;
 		case MKEEP_ALIVE_ATTRIBUTE_IP_PKT:
-			if (!ip_pkt_len) {
+			if (!ip_pkt_len || nla_len(iter) < ip_pkt_len) {
 				ret = -EINVAL;
-				printk("ip packet length is 0\n");
+				printk("ip packet length is invalid\n");
 				goto exit;
 			}
+			kfree(ip_pkt);
 			ip_pkt = (u8 *)kzalloc(ip_pkt_len, kflags);
 			if (ip_pkt == NULL) {
 				ret = -ENOMEM;
@@ -136,12 +145,24 @@ static int aicwf_vendor_start_mkeep_alive(struct wiphy *wiphy,
 			memcpy(ip_pkt, (u8 *)nla_data(iter), ip_pkt_len);
 			break;
 		case MKEEP_ALIVE_ATTRIBUTE_SRC_MAC_ADDR:
+			if (nla_len(iter) < 6) {
+				ret = -EINVAL;
+				goto exit;
+			}
 			memcpy(src_mac, nla_data(iter), 6);
 			break;
 		case MKEEP_ALIVE_ATTRIBUTE_DST_MAC_ADDR:
+			if (nla_len(iter) < 6) {
+				ret = -EINVAL;
+				goto exit;
+			}
 			memcpy(dst_mac, nla_data(iter), 6);
 			break;
 		case MKEEP_ALIVE_ATTRIBUTE_PERIOD_MSEC:
+			if (nla_len(iter) < sizeof(u32)) {
+				ret = -EINVAL;
+				goto exit;
+			}
 			period_msec = nla_get_u32(iter);
 			break;
 		default:
@@ -188,6 +209,8 @@ static int aicwf_vendor_stop_mkeep_alive(struct wiphy *wiphy,
 		type = nla_type(iter);
 		switch (type) {
 		case MKEEP_ALIVE_ATTRIBUTE_ID:
+			if (nla_len(iter) < sizeof(u8))
+				return -EINVAL;
 			mkeep_alive_id = nla_get_u8(iter);
 			break;
 		default:
@@ -301,8 +324,10 @@ static int aicwf_vendor_subcmd_get_channel_list(struct wiphy *wiphy,
 			reply = cfg80211_vendor_cmd_alloc_reply_skb(wiphy,
 								    payload);
 
-			if (!reply)
+			if (!reply) {
+				kfree(channel_list);
 				return -ENOMEM;
+			}
 
 			if (nla_put_u32(reply, GSCAN_ATTRIBUTE_NUM_CHANNELS,
 					num_channels))
@@ -320,6 +345,7 @@ static int aicwf_vendor_subcmd_get_channel_list(struct wiphy *wiphy,
 		default:
 			pr_err("%s(%d), Unknown type: %d\n", __func__, __LINE__,
 			       type);
+			kfree(channel_list);
 			return -EINVAL;
 		}
 	}
@@ -343,15 +369,19 @@ static int aicwf_vendor_subcmd_set_country_code(struct wiphy *wiphy,
 	int ret = 0, rem, type;
 	const struct nlattr *iter;
 	struct ieee80211_regdomain *regdomain;
+	char alpha2[4] = { 0 };
 
 	nla_for_each_attr(iter, data, len, rem) {
 		type = nla_type(iter);
 		switch (type) {
 		case ANDR_WIFI_ATTRIBUTE_COUNTRY:
+			if (nla_len(iter) < 2)
+				return -EINVAL;
+			memcpy(alpha2, nla_data(iter), 2);
+			alpha2[2] = '\0';
 			printk("%s(%d), ANDR_WIFI_ATTRIBUTE_COUNTRY: %s\n",
-			       __func__, __LINE__, (char *)nla_data(iter));
-			regdomain = getRegdomainFromRwnxDB(
-				wiphy, (char *)nla_data(iter));
+			       __func__, __LINE__, alpha2);
+			regdomain = getRegdomainFromRwnxDB(wiphy, alpha2);
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 0, 0)
 			if ((ret = regulatory_set_wiphy_regd(wiphy,
 							     regdomain))) {
@@ -526,25 +556,36 @@ static int aicwf_vendor_logger_start_logging(struct wiphy *wiphy,
 {
 	int ret = 0, rem, type, intval, size, i;
 	const struct nlattr *iter;
-	struct wifi_ring_buffer_status rb;
+	struct wifi_ring_buffer_status rb = { 0 };
 
 	nla_for_each_attr(iter, data, len, rem) {
 		type = nla_type(iter);
 		switch (type) {
 		case LOGGER_ATTRIBUTE_LOG_LEVEL:
+			if (nla_len(iter) < sizeof(u32))
+				return -EINVAL;
 			rb.verbose_level = nla_get_u32(iter);
 			break;
 		case LOGGER_ATTRIBUTE_RING_FLAGS:
+			if (nla_len(iter) < sizeof(u32))
+				return -EINVAL;
 			rb.flags = nla_get_u32(iter);
 			break;
 		case LOGGER_ATTRIBUTE_LOG_TIME_INTVAL:
+			if (nla_len(iter) < sizeof(u32))
+				return -EINVAL;
 			intval = nla_get_u32(iter);
 			break;
 		case LOGGER_ATTRIBUTE_LOG_MIN_DATA_SIZE:
+			if (nla_len(iter) < sizeof(u32))
+				return -EINVAL;
 			size = nla_get_u32(iter);
 			break;
 		case LOGGER_ATTRIBUTE_RING_NAME:
-			strcpy(rb.name, nla_data(iter));
+			if (nla_len(iter) < 1)
+				return -EINVAL;
+			strscpy(rb.name, (const char *)nla_data(iter),
+				min_t(size_t, sizeof(rb.name), nla_len(iter)));
 			break;
 		default:
 			AICWFDBG(LOGERROR, "%s(%d), Unknown type: %d\n",
@@ -574,13 +615,16 @@ static int aicwf_vendor_logger_get_ring_data(struct wiphy *wiphy,
 {
 	int ret = 0, rem, type, i;
 	const struct nlattr *iter;
-	struct wifi_ring_buffer_status rb;
+	struct wifi_ring_buffer_status rb = { 0 };
 
 	nla_for_each_attr(iter, data, len, rem) {
 		type = nla_type(iter);
 		switch (type) {
 		case LOGGER_ATTRIBUTE_RING_NAME:
-			strcpy(rb.name, nla_data(iter));
+			if (nla_len(iter) < 1)
+				return -EINVAL;
+			strscpy(rb.name, (const char *)nla_data(iter),
+				min_t(size_t, sizeof(rb.name), nla_len(iter)));
 			break;
 		default:
 			pr_err("%s(%d), Unknown type: %d\n", __func__, __LINE__,
@@ -725,6 +769,8 @@ static int aicwf_vendor_apf_subcmd_get_capabilities(struct wiphy *wiphy,
 	max_len = 2048;
 
 	skb = cfg80211_vendor_cmd_alloc_reply_skb(wiphy, max_len);
+	if (!skb)
+		return -ENOMEM;
 
 	ret = nla_put_u32(skb, APF_ATTRIBUTE_VERSION, ver);
 	if (ret < 0) {
@@ -745,10 +791,10 @@ static int aicwf_vendor_apf_subcmd_get_capabilities(struct wiphy *wiphy,
 			 ret);
 	}
 
+	return ret;
+
 fail:
-	/* TODO
-	 * Add handle in the future
-	 */
+	kfree_skb(skb);
 	return ret;
 }
 
@@ -764,6 +810,8 @@ static int aicwf_vendor_sub_cmd_set_mac(struct wiphy *wiphy,
 		type = nla_type(iter);
 		switch (type) {
 		case WIFI_VENDOR_ATTR_DRIVER_MAC_ADDR:
+			if (nla_len(iter) < ETH_ALEN)
+				return -EINVAL;
 			memcpy(mac, nla_data(iter), ETH_ALEN);
 			printk("%s, %02X:%02X:%02X:%02X:%02X:%02X\n", __func__,
 			       mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
diff --git a/drivers/aic8800/aic8800/aic8800_fdrv/aicwf_txrxif.c b/drivers/aic8800/aic8800/aic8800_fdrv/aicwf_txrxif.c
