 # Enable HW queue for Broadcast/Multicast traffic (need FW support)
 CONFIG_RWNX_BCMC ?= y
@@ -150,11 +151,11 @@ CONFIG_RWNX_MON_DATA =n
 CONFIG_RWNX_MON_XMIT ?= n
 CONFIG_RWNX_MON_RXFILTER ?= n
 
-CONFIG_FILTER_TCP_ACK =y
