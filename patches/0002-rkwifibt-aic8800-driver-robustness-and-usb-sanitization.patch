 CONFIG_LOAD_BT_PATCH_IN_FDRV = n
 CONFIG_DYNAMIC_PWR = n
 CONFIG_DYNAMIC_PERPWR = n
@@ -140,7 +141,7 @@ CONFIG_RWNX_MUMIMO_TX = n
 endif
 
 # Enable handling of radar event
-CONFIG_RWNX_RADAR ?= y
