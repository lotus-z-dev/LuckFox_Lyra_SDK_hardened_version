 						aggr_len + CCMP_OR_WEP_INFO,
 						GFP_KERNEL); //8 is for ccmp mic or wep icv
@@ -891,6 +898,9 @@ int aicwf_process_rxframes(struct aicwf_rx_priv *rx_priv)
 					else
 						adjust_len = aggr_len;
 
+					if ((u32)aggr_len + 4 > skb->len ||
+					    (u32)adjust_len + 4 > skb->len)
+						break;
 					msg = kmalloc(
