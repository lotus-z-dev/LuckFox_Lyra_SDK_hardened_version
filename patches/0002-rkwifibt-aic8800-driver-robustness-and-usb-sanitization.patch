 obj-$(CONFIG_AIC8800_WLAN_SUPPORT) := $(MODULE_NAME).o
diff --git a/drivers/aic8800/aic8800/aic8800_fdrv/aic_priv_cmd.c b/drivers/aic8800/aic8800/aic8800_fdrv/aic_priv_cmd.c
