 #ifndef CONFIG_USB_RX_REASSEMBLE
 				if (pkt_len > skb->len) {
 					AICWFDBG(
 						LOGERROR,
 						"%s pkt_len:%d skb->len:%d\r\n",
 						__func__, pkt_len, skb->len);
-					//dev_kfree_skb(skb);
-					//atomic_dec(&rx_priv->rx_cnt);
-					//continue;
 					break;
 				}
 #endif
@@ -862,6 +867,8 @@ int aicwf_process_rxframes(struct aicwf_rx_priv *rx_priv)
