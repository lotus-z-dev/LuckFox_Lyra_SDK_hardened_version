-		if (g_rwnx_plat && g_rwnx_plat->usbdev->rwnx_hw) {
-			set_testmode(5);
-			rwnx_send_reboot(g_rwnx_plat->usbdev->rwnx_hw);
-		}
-		ret = 0;
