 			if (msg == NULL) {
 				txrx_err("no more space for msg!\n");
@@ -838,23 +849,17 @@ int aicwf_process_rxframes(struct aicwf_rx_priv *rx_priv)
 			}
 			while (aicwf_another_ptk(skb)) {
 				cnt++;
