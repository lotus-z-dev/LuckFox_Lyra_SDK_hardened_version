diff --git a/drivers/rpmsg/rockchip_rpmsg_test.c b/drivers/rpmsg/rockchip_rpmsg_test.c
index 7f607bd29..ee49be2b8 100644
--- a/drivers/rpmsg/rockchip_rpmsg_test.c
+++ b/drivers/rpmsg/rockchip_rpmsg_test.c
@@ -32,9 +32,12 @@ static int rockchip_rpmsg_test_cb(struct rpmsg_device *rp, void *payload,
 	uint32_t remote_ept_id;
 	struct rpmsg_info_t *info = dev_get_drvdata(&rp->dev);
 
+	if (!info || !payload || payload_len < 0)
+		return -EINVAL;
+
 	remote_ept_id = src;
-	dev_info(&rp->dev, "rx msg %s rx_count %d(remote_ept_id: 0x%x)\n",
-			(char *)payload, ++info->rx_count, remote_ept_id);
+	dev_info(&rp->dev, "rx msg %.*s rx_count %d(remote_ept_id: 0x%x)\n",
+		 payload_len, (char *)payload, ++info->rx_count, remote_ept_id);
 
 	/* test should not live forever */
 	if (info->rx_count >= MSG_LIMIT) {
@@ -47,7 +50,7 @@ static int rockchip_rpmsg_test_cb(struct rpmsg_device *rp, void *payload,
 	ret = rpmsg_sendto(rp->ept, LINUX_TEST_MSG_2, strlen(LINUX_TEST_MSG_2), remote_ept_id);
 	if (ret)
 		dev_err(&rp->dev, "rpmsg_send failed: %d\n", ret);
-		return ret;
+	return ret;
 }
 
