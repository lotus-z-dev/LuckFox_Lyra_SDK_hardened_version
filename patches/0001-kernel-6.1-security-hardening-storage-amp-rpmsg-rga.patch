diff --git a/drivers/soc/rockchip/flash_vendor_storage.c b/drivers/soc/rockchip/flash_vendor_storage.c
index 7c8cd338d..62821ef43 100644
--- a/drivers/soc/rockchip/flash_vendor_storage.c
+++ b/drivers/soc/rockchip/flash_vendor_storage.c
@@ -174,7 +174,8 @@ static int flash_vendor_write(u32 id, void *pbuf, u32 size)
 		}
 	}
 
-	if (g_vendor->free_size >= align_size) {
+	if (g_vendor->free_size >= align_size &&
+	    g_vendor->item_num < ARRAY_SIZE(g_vendor->item)) {
 		item = &g_vendor->item[g_vendor->item_num];
 		item->id = id;
 		item->offset = g_vendor->free_offset;
@@ -243,6 +244,9 @@ static long vendor_storage_ioctl(struct file *file,
 	u32 *temp_buf;
 	struct RK_VENDOR_REQ *req;
 
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+
 	req = kmalloc(sizeof(*req), GFP_KERNEL);
 	if (!req)
 		return ret;
@@ -260,6 +264,10 @@ static long vendor_storage_ioctl(struct file *file,
 			break;
 		}
 		if (req->tag == VENDOR_REQ_TAG) {
+			if (req->len > sizeof(req->data)) {
+				ret = -EINVAL;
+				break;
+			}
 			size = flash_vendor_read(req->id,
 						 req->data,
 						 req->len);
@@ -282,13 +290,15 @@ static long vendor_storage_ioctl(struct file *file,
 			ret = -EFAULT;
 			break;
 		}
-		if (req->tag == VENDOR_REQ_TAG)
-			ret = flash_vendor_write(req->id,
-						 req->data,
-						 req->len);
+		if (req->tag == VENDOR_REQ_TAG &&
+			    req->len <= sizeof(req->data))
+				ret = flash_vendor_write(req->id,
+							 req->data,
+							 req->len);
 	} break;
 	default:
-		return -EINVAL;
+		ret = -EINVAL;
+		break;
 	}
 	kfree(temp_buf);
 	DLOG("flash_vendor_ioctl cmd=%x ret = %lx\n", cmd, ret);
